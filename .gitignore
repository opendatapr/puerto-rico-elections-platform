# Data files (raw data is large, use releases)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.parquet
!data/processed/*.json
data/census/*
!data/census/.gitkeep
!data/census/*.parquet
!data/census/*_metadata.json

# Crosswalks (keep parquet)
data/crosswalks/*
!data/crosswalks/*.parquet

# Shapefiles (keep small metadata, exclude large .shp/.zip)
data/shapes/*
!data/shapes/*.prj
!data/shapes/*.cpg

# PDF maps (can be re-downloaded, keep inventory and summaries)
data/pdf_maps/*
!data/pdf_maps/pdf_inventory.json
!data/pdf_maps/pr_municipality_centroids.json
data/pdf_maps/extracted/*
!data/pdf_maps/extracted/extraction_summary.json
data/pdf_maps/georeferenced/*
!data/pdf_maps/georeferenced/georeferencing_summary.json
data/pdf_maps/validated/*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# But keep webapp's lib components
!webapp/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# R
.Rhistory
.Rdata
.RData
.Ruserdata
*.Rproj.user
packages/r/man/
packages/r/NAMESPACE

# JavaScript/Node
node_modules/
packages/js/dist/
*.tgz
.npm
.eslintcache

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment
.env
.env.local
